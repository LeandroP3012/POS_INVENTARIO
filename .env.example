# Variables de entorno para Railway
# Copia este archivo como .env y completa los valores

# Base de datos MySQL (Railway te provee estos valores)
DB_HOST=your-railway-mysql-host
DB_PORT=3306
DB_NAME=railway
DB_USER=root
DB_PASSWORD=your-password

# Seguridad JWT (cambia este valor en producción)
JWT_SECRET_KEY=cambia-esta-clave-secreta-en-produccion

# Entorno
ENVIRONMENT=production
